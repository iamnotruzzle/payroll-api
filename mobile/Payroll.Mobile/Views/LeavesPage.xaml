<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Payroll.Mobile.ViewModels"
             xmlns:dto="clr-namespace:Payroll.Mobile.Models.Dto"
             xmlns:controls="clr-namespace:Payroll.Mobile.Controls"
             x:Class="Payroll.Mobile.Views.LeavesPage"
             x:DataType="vm:LeavesViewModel"
             Title="My Leave"
             BackgroundColor="{StaticResource PageBackground}">
    <controls:TechBackdrop>
        <Grid RowDefinitions="Auto,*" Padding="20,12,20,8" RowSpacing="12">
            <VerticalStackLayout Spacing="12" HorizontalOptions="Fill">
                <Grid HeightRequest="40">
                    <Image Source="texture_brushed_metal.png"
                           Aspect="AspectFill"
                           Opacity="0.92" />
                    <BoxView Color="#9900E5FF"
                             HeightRequest="1.5"
                             VerticalOptions="End" />
                    <HorizontalStackLayout Padding="14,0"
                                           Spacing="8"
                                           VerticalOptions="Center">
                        <Label Text="▸"
                               TextColor="{StaticResource Accent}"
                               FontAttributes="Bold" />
                        <Label Text="LEAVE  //  REQUESTS"
                               Style="{StaticResource HudCaption}"
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                </Grid>

                <Button Text="▸  File leave" Command="{Binding OpenFormCommand}" />
                <Label Text="{Binding Message}"
                       TextColor="{StaticResource Accent}"
                       HorizontalOptions="Fill" />

                <Border Style="{StaticResource GlassCard}"
                        IsVisible="{Binding ShowForm}">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Fill">
                        <Picker Title="Leave type"
                                ItemsSource="{Binding LeaveTypes}"
                                ItemDisplayBinding="{Binding LeaveName}"
                                SelectedItem="{Binding SelectedLeaveType}" />
                        <DatePicker Date="{Binding StartDate}" />
                        <DatePicker Date="{Binding EndDate}" />
                        <Editor Placeholder="Note (optional)"
                                Text="{Binding ApplicantNote}"
                                HeightRequest="88" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="Submit" Command="{Binding SubmitCommand}" />
                            <Button Text="Cancel"
                                    Grid.Column="1"
                                    Command="{Binding CloseFormCommand}"
                                    Style="{StaticResource OutlineButton}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <CollectionView Grid.Row="1" ItemsSource="{Binding Leaves}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:LeaveDto">
                        <Border Style="{StaticResource GlassCard}"
                                Padding="14"
                                Margin="0,0,0,10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding LeaveTypeName}" FontAttributes="Bold" TextColor="{StaticResource Text}" />
                                <Label Text="{Binding StatusName}" TextColor="{StaticResource Accent}" />
                                <Label Text="{Binding StartDate, StringFormat='▸  From {0}'}" TextColor="{StaticResource Muted}" FontSize="13" />
                                <Label Text="{Binding EndDate, StringFormat='▸  To {0}'}" TextColor="{StaticResource Muted}" FontSize="13" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <ActivityIndicator Grid.Row="1"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>
    </controls:TechBackdrop>
</ContentPage>
