<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Payroll.Mobile.ViewModels"
             xmlns:dto="clr-namespace:Payroll.Mobile.Models.Dto"
             xmlns:controls="clr-namespace:Payroll.Mobile.Controls"
             x:Class="Payroll.Mobile.Views.PayslipsPage"
             x:DataType="vm:PayslipsViewModel"
             Title="My Payslip"
             BackgroundColor="{StaticResource PageBackground}">
    <controls:TechBackdrop>
        <Grid RowDefinitions="Auto,*" Padding="20,12,20,8" RowSpacing="12">
            <Grid HeightRequest="40">
                <Image Source="texture_brushed_metal.png"
                       Aspect="AspectFill"
                       Opacity="0.92" />
                <BoxView Color="#9900E5FF"
                         HeightRequest="1.5"
                         VerticalOptions="End" />
                <HorizontalStackLayout Padding="14,0"
                                       Spacing="8"
                                       VerticalOptions="Center">
                    <Label Text="▸"
                           TextColor="{StaticResource Accent}"
                           FontAttributes="Bold" />
                    <Label Text="PAYSLIP  //  HISTORY"
                           Style="{StaticResource HudCaption}"
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </Grid>

            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding Payslips}"
                            SelectionMode="Single"
                            SelectionChanged="OnSelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:PayslipListItemDto">
                        <Border Style="{StaticResource GlassCard}"
                                Padding="14"
                                Margin="0,0,0,10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding PayrollPeriod}" FontAttributes="Bold" TextColor="{StaticResource Text}" />
                                <Label Text="{Binding PayrollType}" TextColor="{StaticResource Muted}" />
                                <Label Text="{Binding Net, StringFormat='▸  Net {0:N2}'}"
                                       TextColor="{StaticResource Accent}"
                                       FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <ActivityIndicator Grid.Row="1"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>
    </controls:TechBackdrop>
</ContentPage>
