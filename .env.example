# Legacy NDOS (Nursing Division Online Scheduling; connection name schedulev2) — read-only sync / backfill source.
# Used by:
#   php artisan schedule:sync-schedulev2 --dry-run|--apply
#   php artisan schedule:backfill-schedulev2 --dry-run
#   php artisan schedule:backfill-schedulev2 --apply --force [--with-assignments]
DB_HOST_SCHEDULEV2=127.0.0.1
DB_PORT_SCHEDULEV2=3306
DB_DATABASE_SCHEDULEV2=schedulev2
DB_USERNAME_SCHEDULEV2=root
DB_PASSWORD_SCHEDULEV2=
# SCHEDULEV2_DB_CONNECTION=schedulev2
# SCHEDULEV2_SYNC_MONTHS_BACK=1
# SCHEDULEV2_SYNC_MONTHS_AHEAD=1
# Only pull approved employee_schedules (A). Codes: P pending, S submitted, C checked, R recommended, A approved, D deleted.
# SCHEDULEV2_APPROVED_STATUSES=A
# SCHEDULEV2_SKIP_SHIFT_LABELS=OC
# SCHEDULEV2_CREATE_MISSING_SHIFTS=true
# SCHEDULEV2_CREATE_MISSING_UNITS=true
# Optional: HRIS department_id for NDOS locations that do not match any department name
# (default: first CNO/Nursing division department when SCHEDULEV2_BACKFILL_UNMATCHED_TO_CNO=true).
# SCHEDULEV2_BACKFILL_FALLBACK_DEPARTMENT_ID=
# SCHEDULEV2_BACKFILL_UNMATCHED_TO_CNO=true
# Full backfill clears schedule-owned tables then imports refs; always dry-run first. Never lock→DTR.

# CNO / Nursing Service HRIS division_id (Chief Nurse Office scheduling mode).
# Departments in this division auto-get nursing schedule profile defaults.
# SCHEDULE_CNO_DIVISION_ID=3

DB_CACHE_CONNECTION=payroll_scheduler

FILESYSTEM_DISK=local
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Schedule PDF email distribution (Phase 5b) needs a real FROM address and a non-array mailer.
# With hello@example.com (or MAIL_MAILER=array), Download PDF still works; Email PDF shows "mail not configured".
# Optional: allow smtp to 127.0.0.1 for local relays (Mailpit/Mailhog).
# SCHEDULE_ALLOW_LOCAL_SMTP=false

VITE_APP_NAME="${APP_NAME}"

# Payroll data authority. PAYROLL_FORCE_MODE, when set, locks the Super Admin selector.
PAYROLL_OPERATION_MODES=connected,standalone
PAYROLL_DEFAULT_MODE=connected
PAYROLL_FORCE_MODE=
# Generate with: php artisan payroll:hash-super-admin-switch
SUPER_ADMIN_SWITCH_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# API auth (Phase 6 — attendance bridges / lockdown)
# ---------------------------------------------------------------------------
# Comma-separated device keys for biometric clocks + offline DTR sync clients.
# Also accepted for schedule week/attendance read APIs (Phase 5b) via api.access.
# Send as: X-API-Key: <key>  OR  Authorization: Bearer <key>
# API_DEVICE_KEYS=dev-clock-key-change-me,offline-sync-key-change-me
API_DEVICE_KEYS=

# When true, /api/* (except auth/login and mobile/auth/login) requires web session, Sanctum token, or a device key.
# Device punch/sync routes ALWAYS require a device key regardless of this flag.
# Schedule week/attendance: GET /api/schedule/week and GET /api/schedule/attendance
# (approved/locked presence only on attendance — not biometric DTR).
API_REQUIRE_AUTH=true

# Sanctum stateful domains (comma-separated) for cookie/session API calls from the browser.
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
